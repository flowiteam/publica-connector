{
    "name": "flowiteam/publica-connector",
    "description": "Receive articles from PUBLICA into a Laravel site: four signed routes, no admin user, no open REST surface.",
    "keywords": ["laravel", "publica", "publishing", "content"],
    "homepage": "https://publica.flowiteam.com",
    "license": "MIT",
    "authors": [
        {
            "name": "flowITeam",
            "email": "info@flowiteam.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "laravel/pint": "^1.18",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Flowiteam\\PublicaConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flowiteam\\PublicaConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flowiteam\\PublicaConnector\\PublicaConnectorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
